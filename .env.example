# JIRA Configuration
JIRA_URL=https://your-instance.atlassian.net
JIRA_USERNAME=your-jira-username
JIRA_PASSWORD=your-jira-password

# Optional: restrict to specific projects (comma-separated).
# Leave unset to fetch all projects accessible to the user.
# JIRA_PROJECT_KEYS=PROJ1,PROJ2,PROJ3

JIRA_MAX_RESULTS=1000

# Dashboard Configuration
CACHE_TIMEOUT=900
DEBUG=False
PORT=8050
HOST=0.0.0.0

# Optional: Multiple Projects (comma-separated)
# JIRA_PROJECT_KEYS=PROJ1,PROJ2,PROJ3
